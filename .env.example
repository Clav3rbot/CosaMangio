# Copia questo file in .env.local e riempi i valori. In produzione le stesse variabili vanno nelle
# Environment Variables di Vercel.

# Supabase: Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chiave segreta (service_role o sb_secret_...): serve solo al server per mandare le notifiche. Mai nel browser.
SUPABASE_SERVICE_ROLE_KEY=

# Notifiche push: node node_modules/web-push/src/cli.js generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Un contatto per i servizi push, per esempio mailto:tu@example.com
VAPID_SUBJECT=

# Segreto che il cron di Supabase manda a /api/push/tick: una stringa lunga a caso,
# per esempio node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
